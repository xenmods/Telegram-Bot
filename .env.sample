# Telegram API Credentials
BOT_TOKEN=your_bot_token_from_botfather
API_ID=your_api_id
API_HASH=your_api_hash

# Database Configuration (with async drivers)
DB_URI=sqlite+aiosqlite:///Bot.db

# For PostgreSQL: DB_URI=postgresql+asyncpg://username:password@localhost/dbname
# For MySQL: DB_URI=mysql+aiomysql://username:password@localhost/dbname

# MongoDB Configuration
MONGO_URL=your_mongodb_url
DB_NAME=your_database_name